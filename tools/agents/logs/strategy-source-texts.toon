\",description:\"Replace draws with graveyard fills for explosive recursion\",keywords:[\"dredge\",\"replace.*draw\",\"mill.*return\",\"whenever.*card.*put.*graveyard\"]},{name:\"Flashback\",description:\"Cast spells twice — once from hand, once from the grave\",keywords:[\"flashback\",\"cast.*from.*graveyard\",\"escape\",\"retrace\",\"aftermath\"],searchTerms:[\"flashback\",\"cast from your graveyard\",\"experience counter\"]}],keywords:[\"graveyard\",\"reanimate\",\"return.*battlefield\",\"mill\",\"discard\",\"flashback\",\"unearth\",\"escape\",\"dredge\",\"surveil\"]},{id:\"blink\",name:\"Blink\",description:\"Flicker creatures for repeated enter-the-battlefield triggers\",icon:\"👁️\",subArchetypes:[{name:\"ETB Value\",description:\"Maximise enter-the-battlefield triggers by repeatedly flickering creatures\",keywords:[\"enters the battlefield\",\"when.*enters\",\"whenever.*enters\",\"etb\",\"enters,\"],searchTerms:[\"enters the battlefield\",\"at the beginning of the next end step\"]},{name:\"Flicker Combo\",description:\"Set up infinite flicker loops to win on the spot\",keywords:[\"exile.*return.*battlefield\",\"flicker\",\"infinite\",\"untap.*when.*enters\",\"each time\"]},{name:\"Panharmonicon\",description:\"Double your ETB triggers for overwhelming value\",keywords:[\"additional time\",\"triggers.*twice\",\"double.*trigger\",\"panharmonicon\",\"if.*would.*trigger\"]},{name:\"Soulherder\",description:\"Gradually accumulate value by flickering one creature each turn\",keywords:[\"exile.*return.*end step\",\"at.*end step.*return\",\"exile.*creature.*you control\",\"soulherder\"],searchTerms:[\"exile target creature you control\",\"return it to the battlefield\",\"whenever a creature is exiled from the battlefield\"]}],keywords:[\"flicker\",\"blink\",\"exile.*return.*battlefield\",\"return.*to the battlefield under\",\"enters the battlefield.*you\",\"when.*enters the battlefield\",\"whenever.*enters the battlefield\",\"enters, \",\"exile.*then return\"],searchT