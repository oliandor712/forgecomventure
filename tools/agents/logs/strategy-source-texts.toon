\",description:\"Lock opponents out with oppressive permanents and resource denial\",icon:\"🔒\",subArchetypes:[{name:\"Tax\",description:\"Make opponents pay extra for every action they take\",keywords:[\"costs? \\\\d+ more\",\"additional cost\",\"tax\",\"pay.*or.*sacrifice\",\"rhystic\"],searchTerms:[\"costs more to cast\",\"additional cost\",\"more to cast\"]},{name:\"Resource Denial\",description:\"Deny opponents access to mana, cards, and untap steps\",keywords:[\"don't untap\",\"skip.*untap\",\"winter orb\",\"stasis\",\"static orb\"]},{name:\"Hatebears\",description:\"Deploy creatures that shut down specific strategies\",keywords:[\"can't.*cast\",\"opponents can't\",\"enters.*tapped\",\"can't.*search\",\"whenever.*opponent\"],searchTerms:[\"opponents can't\",\"can't cast\",\"pay X life\"]},{name:\"Winter Orb\",description:\"Break parity on symmetrical lock effects to stay ahead\",keywords:[\"don't untap\",\"untap.*only\",\"stasis\",\"winter orb\",\"tap.*all\"]}],keywords:[\"cost\",\"more\",\"can't\",\"each player\",\"nonland\",\"tax\",\"sacrifice.*each\"]},{id:\"counters\",name:\"Counters\",description:\"Grow creatures with +1/+1 counters and counter synergies\",icon:\"📈\",subArchetypes:[{name:\"+1/+1 Counters\",description:\"Grow creatures by stacking +1/+1 counters for massive threats\",keywords:[\"\\\\+1/\\\\+1 counter\",\"put.*counter.*on\",\"enters.*with.*counter\",\"whenever.*counter.*placed\"],searchTerms:[\"put a counter on\",\"counters on it\",\"counter on target creature\"]},{name:\"Proliferate\",description:\"Multiply all your counters at once with proliferate effects\",keywords:[\"proliferate\",\"for each counter\",\"double.*counters\",\"additional counter\"]},{name:\"Modular\",description:\"Move counters between artifacts when they die for persistent power\",keywords:[\"modular\",\"move.*counter\",\"when.*dies.*put.*counter\",\"artifact.*counter\"]},{name:\"Hydras\",description:\"Cast X-cost hydras that scale with your available mana\",keywords:[\"