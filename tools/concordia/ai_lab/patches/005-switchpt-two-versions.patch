+    /**
+     * SwitchPT on the host itself: the host is two creatures, "as it is now" (P/T) and "switched" (T/P). Forge's own pump
+     * predictor (ComputerUtilCard.shouldPumpCard: first strike, deathtouch, indestructible, prevention, trample, marked
+     * damage) decides if the switched version is better in this combat; when the ability has a discard cost the gain must
+     * also beat what the card is worth (about 60 for a spare land, else 120).
+     */
+    private static boolean switchPTHelps(final Player ai, final SpellAbility sa) {
+        final Card host = sa.getHostCard();
+        final forge.game.combat.Combat combat = host.getGame().getCombat();
+        if (combat == null || host.getNetPower() == host.getNetToughness()
+                || !(combat.isAttacking(host) || combat.isBlocking(host))) {
+            return false;
+        }
+        final int p = host.getNetPower();
+        final int t = host.getNetToughness();
+        if (host.getGame().getPhaseHandler().is(PhaseType.COMBAT_DECLARE_ATTACKERS) && switchPTNoPotentialBlockers(host)) {
+            // nothing can block the host: shouldPumpCard only predicts unblocked attackers once blockers are declared, so compare
+            // the two versions directly (damage to the defender, lethal counts most)
+            if (versionScore(ai, host, combat, t, p) <= versionScore(ai, host, combat, p, t)) {
+                return false;
+            }
+        } else if (!ComputerUtilCard.shouldPumpCard(ai, sa, host, p - t, t - p, java.util.Collections.<String>emptyList())) {
+            return false;
+        }
+        if (sa.getPayCosts() != null && sa.getPayCosts().hasSpecificCostType(forge.game.cost.CostDiscard.class)) {
+            final int cardValue = !CardLists.filter(ai.getCardsIn(ZoneType.Hand), Card::isLand).isEmpty() ? 60 : 120;
+            return versionScore(ai, host, combat, t, p) - versionScore(ai, host, combat, p, t) > cardValue;
+        }
+        return true;
+    }
+
+    // value of the host being a creature with this power/toughness in the current combat (higher = better for the AI)
+    private static int versionScore(final Player ai, final Card host, final forge.game.combat.Combat combat,
+                                    final int power, final int toughness) {
+        final int hostValue = ComputerUtilCard.evaluateCreature(host);
+        final boolean attacking = combat.isAttacking(host);
+        final forge.game.card.CardCollection opp = attacking ? combat.getBlockers(host)
+                : combat.isBlocking(host) ? combat.getAttackersBlockedBy(host) : new forge.game.card.CardCollection();
+        if (!attacking && opp.isEmpty()) {
+            return 0; // not in this combat: neither version does anything
+        }
+        int score = 0;
+        if (attacking && opp.isEmpty()) {
+            final forge.game.GameEntity def = combat.getDefenderByAttacker(host);
+            final boolean lethal = (def instanceof Player && power >= ((Player) def).getLife())
+                    || (def instanceof Card && power >= ((Card) def).getCounters(forge.game.card.CounterEnumType.LOYALTY));
+            return lethal ? 10000 : power * 10; // unblocked: damage to the defender
+        }
+        // blocked attacker or blocker: damage assignment to the opposing creatures, cheapest kills first
+        int toHost = 0;
+        final java.util.List<Card> sorted = new java.util.ArrayList<>(opp);
+        sorted.sort(java.util.Comparator.comparingInt(Card::getLethalDamage));
+        int left = power;
+        for (final Card c : sorted) {
+            toHost += Math.max(0, c.getNetCombatDamage());
+            if (left >= c.getLethalDamage()) {
+                left -= c.getLethalDamage();
+                score += ComputerUtilCard.evaluateCreature(c);
+            }
+        }
+        if (toHost >= toughness) {
+            score -= hostValue;
+        }
+        return score;
+    }
+
+    // true if the host attacks and no untapped creature of the defending player can block it (so blocks cannot change the outcome)
+    private static boolean switchPTNoPotentialBlockers(final Card host) {
+        final forge.game.combat.Combat combat = host.getGame().getCombat();
+        if (combat == null || !combat.isAttacking(host)) {
+            return false;
+        }
+        final Player defender = combat.getDefenderPlayerByAttacker(host);
+        if (defender == null) {
+            return false;
+        }
+        for (final Card c : defender.getCreaturesInPlay()) {
+            if (CombatUtil.canBlock(host, c)) {
+                return false;
+            }
+        }
+        return true;
+    }
