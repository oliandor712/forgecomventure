+    /** Log-only (patch 012): runs one blocking pass and logs the blocks it added, with the pass name. */
+    private void logPass(final String pass, final Combat combat, final Runnable body) {
+        if (!AiDecisionLog.enabled()) {
+            body.run();
+            return;
+        }
+        final java.util.Set<String> before = new java.util.HashSet<>();
+        for (Card bl : combat.getAllBlockers()) {
+            for (Card at : combat.getAttackersBlockedBy(bl)) {
+                before.add(bl.getId() + ">" + at.getId());
