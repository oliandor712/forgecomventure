+            for (Card at : combat.getAttackersBlockedBy(bl)) {
+                if (!before.contains(bl.getId() + ">" + at.getId())) {
+                    AiDecisionLog.add("BLOCK_REASON\t" + ai.getName() + "\tturn=" + ai.getGame().getPhaseHandler().getTurn()
+                            + "\tphase=" + ai.getGame().getPhaseHandler().getPhase() + "\tpass=" + pass + "\tblocker=" + bl.getName().replace(' ', '_')
+                            + "\tattacker=" + at.getName().replace(' ', '_') + "\tlife=" + ai.getLife());
+                }
+            }
+        }
+    }
