diff --git a/forge-ai/src/main/java/forge/ai/AiDecisionLog.java b/forge-ai/src/main/java/forge/ai/AiDecisionLog.java
new file mode 100644
index 00000000..e90c5609
--- /dev/null
+++ b/forge-ai/src/main/java/forge/ai/AiDecisionLog.java
@@ -0,0 +1,35 @@
+package forge.ai;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/** Log-only: records AI decisions for the phase digest. Never read by the AI, so it cannot change a decision. Enabled by -Daidecisionlog. */
+public final class AiDecisionLog {
+    private static final List<String> ENTRIES = new ArrayList<>();
+
+    private AiDecisionLog() {
+    }
+
+    public static boolean enabled() {
+        return System.getProperty("aidecisionlog") != null;
+    }
+
+    public static synchronized void add(final String entry) {
+        ENTRIES.add(entry);
+    }
+
+    private static final java.util.Map<String, Integer> LAST_TURN = new java.util.HashMap<>();
+
+    /** True the first time this player is asked in this turn; keeps SPELL_CHOICE to one line per player per turn. */
+    public static synchronized boolean firstThisTurn(final forge.game.player.Player p, final int turn) {
+        Integer last = LAST_TURN.put(p.getName(), turn);
+        return last == null || last != turn;
+    }
+
+    /** Returns and clears the entries recorded since the last call. */
+    public static synchronized List<String> drain() {
+        List<String> out = new ArrayList<>(ENTRIES);
+        ENTRIES.clear();
+        return out;
+    }
+}
