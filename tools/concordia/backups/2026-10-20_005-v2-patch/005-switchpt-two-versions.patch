+    /**
+     * SwitchPT on the host itself: treat the host as two creatures, "as it is now" (P/T) and "switched" (T/P), score
+     * what each would do in the rest of this combat, and switch only if the other version scores higher. The switched
+     * version is a temporary extra option: the current one is not lost, so after switching the roles are reversed and
+     * the same comparison decides whether to switch back (it won't unless the situation changed).
+     */
+    private static boolean switchPTHelps(final Player ai, final Card host) {
+        final forge.game.combat.Combat combat = host.getGame().getCombat();
+        if (combat == null || host.getNetPower() == host.getNetToughness()) {
+            return false;
+        }
+        final int p = host.getNetPower();
+        final int t = host.getNetToughness();
+        return versionScore(ai, host, combat, t, p) > versionScore(ai, host, combat, p, t);
+    }
+
+    // value of the host being a creature with this power/toughness in the current combat (higher = better for the AI)
+    private static int versionScore(final Player ai, final Card host, final forge.game.combat.Combat combat,
+                                    final int power, final int toughness) {
+        final int hostValue = ComputerUtilCard.evaluateCreature(host);
+        final boolean attacking = combat.isAttacking(host);
+        final forge.game.card.CardCollection opp = attacking ? combat.getBlockers(host)
+                : combat.isBlocking(host) ? combat.getAttackersBlockedBy(host) : new forge.game.card.CardCollection();
+        if (!attacking && opp.isEmpty()) {
+            return 0; // not in this combat: neither version does anything
+        }
+        int score = 0;
+        if (attacking && opp.isEmpty()) {
+            final forge.game.GameEntity def = combat.getDefenderByAttacker(host);
+            final boolean lethal = def instanceof Player && power >= ((Player) def).getLife();
+            return lethal ? 10000 : power * 10; // unblocked: damage to the defender
+        }
+        // blocked attacker or blocker: damage assignment to the opposing creatures, cheapest kills first
+        int toHost = 0;
+        final java.util.List<Card> sorted = new java.util.ArrayList<>(opp);
+        sorted.sort(java.util.Comparator.comparingInt(Card::getLethalDamage));
+        int left = power;
+        for (final Card c : sorted) {
+            toHost += Math.max(0, c.getNetCombatDamage());
+            if (left >= c.getLethalDamage()) {
+                left -= c.getLethalDamage();
+                score += ComputerUtilCard.evaluateCreature(c);
+            }
+        }
+        if (toHost >= toughness) {
+            score -= hostValue;
+        }
+        return score;
+    }
+
